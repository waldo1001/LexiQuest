{
  "version": 1,
  "specs": {
    "glob": "docs/specs/*.md",
    "status_field": "status"
  },
  "build": "/sdd-build {spec}",
  "draft": "/sdd-draft {issue}",
  "commands": [
    "npm run test:api",
    "npm run test:frontend",
    "npm run test:file:api",
    "npm run test:file:frontend",
    "node scripts/validate-specs.js"
  ],
  "pre_build": [
    "npm ci --prefix api --no-audit --no-fund",
    "npm ci --prefix frontend --no-audit --no-fund"
  ],
  "ci_required": [
    "CI"
  ],
  "protected": [
    "api/package.json",
    "frontend/package.json",
    "api/host.json",
    "staticwebapp.config.json",
    "api/scripts/**"
  ]
}
